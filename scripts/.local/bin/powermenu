#!/usr/bin/env bash

lock=" Lock"
suspend=" Suspend"
hibernate=" Hibernate"
logout=" Logout"
reboot=" Reboot"
shutdown=" Shutdown"

chosen=$(
	printf "%s\n" "$lock" "$suspend" "$hibernate" "$logout" "$reboot" "$shutdown" |
		rofi -dmenu -p "" \
			-theme ~/.config/rofi/powermenu.rasi \
			-kb-custom-1 "l" \
			-kb-custom-2 "s" \
			-kb-custom-3 "h" \
			-kb-custom-4 "u" \
			-kb-custom-5 "r" \
			-kb-custom-6 "o"
)
exit_code=$?

case "$exit_code" in
10) loginctl lock-session ;;
11) systemctl suspend ;;
12) systemctl hibernate ;;
13) hyprctl dispatch exit ;;
14) systemctl reboot ;;
15) systemctl poweroff ;;
esac

[ -z "$chosen" ] && exit 0

case "$chosen" in
"$lock") loginctl lock-session ;;
"$suspend") systemctl suspend ;;
"$hibernate") systemctl hibernate ;;
"$logout") hyprctl dispatch exit ;;
"$reboot") systemctl reboot ;;
"$shutdown") systemctl poweroff ;;
esac
