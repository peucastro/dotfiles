* {
    bg-color:     #1e1e1e;
    fg-color:     #c8c8c8;
    fg-selected:  #ffffff;
    bg-selected:  #333333;
    border-color: #444444;

    background-color: transparent;
    text-color:       @fg-color;
}

window {
    background-color: @bg-color;
    border:           2px;
    border-color:     @border-color;
    padding:          25px;
    width:            30%;
}

inputbar {
    enabled: false;
}

listview {
    lines:   3;
    columns: 2;
    spacing: 16px;
}

element {
    padding: 28px 20px;
}

element-icon {
    enabled: false;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element selected normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
    border-radius:    5px;
}
