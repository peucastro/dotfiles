{
  "layer": "top",
  "spacing": 16,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "power-profiles-daemon",
    "hyprland/language",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "temperature",
    "wireplumber",
    "backlight",
    "battery"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },
  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true,
    "icon": true
  },
  "clock": {
    "format": "{:%H:%M - %a, %d %b %Y}",
    "tooltip": false
  },
  "tray": {
    "spacing": 8
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip": false
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "tooltip": false
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "us",
    "format-pt": "pt",
    "on-click": "hyprctl switchxkblayout all next",
    "tooltip": false
  },
  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀 {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-disconnected": "󱚼",
    "format-linked": "󱚼",
    "on-click": "nm-connection-editor",
    "tooltip": false
  },
  "bluetooth": {
    "format": "󰂯 {status}",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂯 {num_connections}",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager",
    "tooltip": false
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": " {percentage}%",
    "tooltip": false
  },
  "temperature": {
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "warning-threshold": 70,
    "critical-threshold": 90,
    "tooltip": false
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": [
      "",
      "",
      ""
    ],
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip": false
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󱩎",
      "󱩏",
      "󱩐",
      "󱩑",
      "󱩒",
      "󱩓",
      "󱩔",
      "󱩕",
      "󱩖",
      "󰛨"
    ],
    "scroll-step": 5,
    "tooltip": false
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": false
  }
}
